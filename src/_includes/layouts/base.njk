<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title and page.url != "/" %}{{ title }} – {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
{% if site.url %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
<link rel="icon" href="/images/logos/logo-mark.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@200;300;400;500;600;700&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap">
<link rel="stylesheet" href="/css/settings.css">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="/css/pages.css">
{% for css in extraCss %}<link rel="stylesheet" href="{{ css }}">
{% endfor %}
</head>
<body>
{% include "partials/icons.njk" %}
{% if labs %}{% include "partials/lab-bar.njk" %}{% endif %}
<a class="skip" href="#main">Skip to content</a>
<div class="site">
{% include "partials/header.njk" %}
{{ content | safe }}
{% include "partials/footer.njk" %}
</div>
{% include "partials/overlays.njk" %}
<script src="/js/site.js"></script>
{% for js in extraJs %}<script src="{{ js }}"></script>
{% endfor %}
</body>
</html>
